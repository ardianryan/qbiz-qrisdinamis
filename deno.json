{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "hono": "npm:hono@^4.7.2",
    "hono/": "npm:/hono@^4.7.2/",
    "@hono/react-renderer": "npm:@hono/react-renderer@^1.0.1",
    "react": "npm:react@^19.0.0",
    "react/jsx-runtime": "npm:react@^19.0.0/jsx-runtime",
    "react-dom": "npm:react-dom@^19.0.0",
    "react-dom/server": "npm:react-dom@^19.0.0/server",
    "@types/react": "npm:@types/react@^19.0.10",
    "@types/react-dom": "npm:@types/react-dom@^19.0.4",
    "lucide-react": "npm:lucide-react@^0.475.0",
    "postgres": "npm:postgres@^3.4.5",
    "drizzle-orm": "npm:drizzle-orm@^0.30.10",
    "drizzle-orm/": "npm:/drizzle-orm@^0.30.10/",
    "drizzle-kit": "npm:drizzle-kit@^0.21.4",
    "puppeteer": "npm:puppeteer@^24.2.1"
  },
  "tasks": {
    "dev": "deno run -A --env --watch main.tsx",
    "build:css": "deno run -A npm:tailwindcss@3 -i src/styles/input.css -o static/styles.css --minify",
    "watch:css": "deno run -A npm:tailwindcss@3 -i src/styles/input.css -o static/styles.css --watch",
    "test": "deno test -A --env src/utils/qris.test.ts src/utils/api.test.ts src/utils/crypto.test.ts src/services/notification.test.ts src/services/settings.test.ts src/services/api-keys.test.ts src/services/webhooks.test.ts",
    "db:generate": "deno run -A --env npm:drizzle-kit generate",
    "db:migrate": "deno run -A --env db/migrate.ts",
    "db:seed": "deno run -A --env db/seed.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
